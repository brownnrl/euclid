{
  "compilerOptions": {
    "outDir": "../dist",
    "module": "commonjs",
    "target": "es5",
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "removeComments": false,
    "moduleResolution": "node",
    "declaration": true,
    "lib": ["es5", "dom"]
  },
  "include": ["./**/*"]
}
